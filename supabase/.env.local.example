# Edge Function secrets for local development.
# Copy to supabase/.env.local — never commit this file.

# bcrypt hash of the household password (cost factor 12).
# Generate with: node -e "const b=require('bcryptjs'); b.hash('yourpassword',12).then(console.log)"
APP_PASSWORD_HASH=$2a$12$your_bcrypt_hash_here

# Found in: Supabase dashboard → Settings → API → JWT Secret
JWT_SECRET=your-jwt-secret-here

# Service role key (for Edge Function DB access)
# Found in: Supabase dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_URL=https://your-project.supabase.co
